#!/usr/bin/env bash
# Hook pre-commit de git: rechaza commits que modifiquen rutas congeladas.
# La fase que rige es la de HEAD, que es la fase en la que se hicieron los cambios.
# Los commits de transición los hace la CLI (.fases/fase) con FASES_TRANSICION=1.

source "$(dirname "${BASH_SOURCE[0]}")/../lib.sh"

rama="$(rama_actual)"
for protegida in $RAMAS_PROTEGIDAS; do
  if [[ "$rama" == "$protegida" ]] && git rev-parse -q --verify HEAD >/dev/null; then
    echo "Commit rechazado: no se commitea directo en $rama. Creá una rama y abrí un PR (ver docs/METODOLOGIA.md §9)." >&2
    exit 1
  fi
done

[[ "${FASES_TRANSICION:-}" == 1 ]] && exit 0
git rev-parse -q --verify HEAD >/dev/null || exit 0

cargar_config
leer_estado "$(git show HEAD:.fases/estado 2>/dev/null)"
[[ -n "$FASE" ]] || exit 0
declarados="$(componentes_declarados)"

# Tag del último gate: restaurar un archivo congelado a esa versión siempre está permitido.
case "$FASE" in
  TESTS) tag_gate="$FEATURE/spec-aprobada" ;;
  IMPL)  tag_gate="$FEATURE/tests-aprobados" ;;
  *)     tag_gate="" ;;
esac

rechazados=""
while IFS= read -r rel; do
  [[ -n "$rel" ]] || continue
  if [[ "$rel" == .fases/estado ]]; then
    rechazados+="  .fases/estado solo lo modifica .fases/fase"$'\n'
  elif ! ruta_permitida "$rel" "$FASE" git "$declarados"; then
    [[ -n "$tag_gate" ]] && git diff --cached --quiet "$tag_gate" -- "$rel" 2>/dev/null && continue
    rechazados+="  $MOTIVO"$'\n'
  fi
done < <(git diff --cached --name-only --no-renames)

if [[ -n "$rechazados" ]]; then
  echo "Commit rechazado (fase $FASE, feature $FEATURE):" >&2
  printf '%s' "$rechazados" >&2
  echo "Para cambiar de fase usá .fases/fase (ver docs/METODOLOGIA.md)." >&2
  exit 1
fi
exit 0
